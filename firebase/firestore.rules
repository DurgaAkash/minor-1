rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Set the admin custom claim using a trusted Admin SDK environment.
    // Never let a browser client assign its own admin role.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /checkins/{checkinId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.passengers is int
        && request.resource.data.passengers > 0
        && request.resource.data.passengers <= 100;
      allow read: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "PENDING"
        && request.resource.data.passengers is int
        && request.resource.data.passengers > 0
        && request.resource.data.passengers <= 500;
      allow read: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "adminNote", "reviewedAt", "updatedAt"]);
      allow delete: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Deny access to all collections not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
